# Firefly III application env. Rendered by bin/ksm-render from Keeper.
# Keeper records (under Nikflix/secrets-manager/int-per-dk-01/):
#   - firefly-app : APP_KEY, DB_PASSWORD, MAIL_PASSWORD,
#                   STATIC_CRON_TOKEN, FIREFLY_III_ACCESS_TOKEN,
#                   AUTO_IMPORT_SECRET

APP_ENV=production
APP_DEBUG=false
SITE_OWNER=admin@internik.net
APP_KEY={{keeper:firefly-app/APP_KEY}}
DEFAULT_LANGUAGE=en_US
DEFAULT_LOCALE=equal
TZ=Australia/Perth
TRUSTED_PROXIES=*
LOG_CHANNEL=stack
APP_LOG_LEVEL=notice
AUDIT_LOG_LEVEL=emergency

# Database — must match firefly/.db.env (MYSQL_PASSWORD)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD={{keeper:firefly-app/DB_PASSWORD}}

# 32-char token shared with the cron container (compose substitutes ${STATIC_CRON_TOKEN}).
STATIC_CRON_TOKEN={{keeper:firefly-app/STATIC_CRON_TOKEN}}

APP_URL=https://finance.internik.net

# Mail (smtp2go)
MAIL_MAILER=log
MAIL_HOST=mail-au.smtp2go.com
MAIL_PORT=2525
MAIL_FROM=firefly@internik.net
MAIL_USERNAME=internik-firefly
MAIL_PASSWORD={{keeper:firefly-app/MAIL_PASSWORD}}
MAIL_ENCRYPTION=tls
MAIL_SENDMAIL_COMMAND=

# Redis (currently unused — driver is file)
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB="0"
REDIS_CACHE_DB="1"

CACHE_DRIVER=file
SESSION_DRIVER=file

COOKIE_PATH="/"
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ENABLE_EXTERNAL_MAP=false
ENABLE_EXCHANGE_RATES=false
ENABLE_EXTERNAL_RATES=false
MAP_DEFAULT_LAT=-31.95
MAP_DEFAULT_LONG=115.86
MAP_DEFAULT_ZOOM=6

VALID_URL_PROTOCOLS=https
AUTHENTICATION_GUARD=web
CUSTOM_LOGOUT_URL=
DISABLE_FRAME_HEADER=false
DISABLE_CSP_HEADER=false
ALLOW_WEBHOOKS=false
FIREFLY_III_LAYOUT=v1

FIREFLY_III_ACCESS_TOKEN={{keeper:firefly-app/FIREFLY_III_ACCESS_TOKEN}}
AUTO_IMPORT_SECRET={{keeper:firefly-app/AUTO_IMPORT_SECRET}}
