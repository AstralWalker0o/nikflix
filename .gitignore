# Credentials and machine-local state — never commit
.cf-access
.cf-hosts
.cf-ssh-key
.cf-ssh-key.pub
.ssh-known_hosts
.keeper/
*.keeper-config*

# Discovery output (raw dumps from hosts; promote to docs/ after review)
discovery/

# Real .env files contain secrets — only the .env.example templates ship.
**/.env
**/.db.env
!**/.env.example
!**/.db.env.example
