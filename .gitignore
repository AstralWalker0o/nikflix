# Credentials and machine-local state — never commit
.cf-access
.cf-hosts
.cf-ssh-key
.cf-ssh-key.pub
.ssh-known_hosts
.keeper/
*.keeper-config*

# Discovery output (raw dumps from hosts; promote to docs/ after review)
discovery/

# Real .env files contain secrets — rendered by bin/ksm-render at deploy
# time from the .env.template files (which are committed).
**/.env
**/.db.env
!**/.env.template
!**/.db.env.template
